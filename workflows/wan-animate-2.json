{
  "id": "wan-animate-2",
  "name": "Wan Animate 2 — Motion Transfer",
  "description": "Reference-character animation driven by a short source performance. Generates a new scene; does not preserve the source background. Local inference is not yet benchmarked.",
  "license": "MIT (this workflow pack); model Apache-2.0; ComfyUI GPL-3.0",
